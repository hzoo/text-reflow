    "vite": "^7.2.4"
  },
  "dependencies": {
    "@preact/signals": "^2.6.1",
    "@preact/signals-core": "^1.12.2",
    "@tailwindcss/vite": "^4.1.18",
    "marked": "^17.0.1",
    "preact": "^10.28.2",
    "tailwindcss": "^4.1.18"
  }
}
